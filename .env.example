# ============================================================
# ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already gitignored.
# ============================================================

# --- Site ---
# The canonical production URL, used for metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.northfield.agency

# --- Contact form email delivery (optional) ---
# Only needed once you connect a real email provider in
# app/api/contact/route.ts. Uncomment and fill in the variables
# for whichever provider you choose.

# Resend (https://resend.com)
# RESEND_API_KEY=

# Formspree (https://formspree.io)
# FORMSPREE_FORM_ID=

# HubSpot (https://developers.hubspot.com/docs/api/marketing/forms)
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_ID=

# Address to receive contact form notifications
# CONTACT_EMAIL_TO=hello@northfield.agency

# --- Analytics (optional) ---
# Leave blank to keep analytics disabled. See lib/site.ts and
# README.md "Analytics" section for where these are read.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG_ID=
